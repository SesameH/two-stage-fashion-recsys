# The build context must not include the raw dataset (3.5 GB) or the local venv (584 MB);
# without this the daemon copies ~4.5 GB before the first layer is even built.
.venv/
__pycache__/
*.pyc
.pytest_cache/
.git/
data/raw/
notebooks/
reports/
tests/
# The processed Parquet is training-only. Serving needs exactly one file from it: the
# customer_id -> customer_key map used to resolve incoming request ids.
data/processed/*
!data/processed/customer_id_map.parquet
# Experiment artefacts; the image ships one model.
models/*
!models/ranker.txt
!models/features.json

# Product images are for the LOCAL demo and README screenshots only. They are H&M's commercial
# photography; serving them from a public deployment would be redistribution, which the
# competition data licence does not cover. Excluding them here means a later `docker build`
# cannot pick them up by accident — the console already degrades to product-type tiles.
data/serving/images/

# ALS artefacts: precompute writes item factors and a FAISS index, but R4 is off by default in
# the ranking pipeline and nothing in src/serve reads them. 73 MB of image for zero requests.
data/serving/als_*

